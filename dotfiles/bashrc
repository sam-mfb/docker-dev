# docker-dev shell settings. Installed as ~/.docker-dev/bashrc and loaded from
# the end of ~/.bashrc, so the base image's own bashrc still runs first.

# Environment for installed tools (PATH, nvm, .NET, forwarders, ...).
[ -f "$HOME/.docker-dev/env.sh" ] && . "$HOME/.docker-dev/env.sh"

# The rest is for interactive shells only.
case $- in *i*) ;; *) return ;; esac

# Define our custom colors (for better readability)
COLOR_HOST=220    # yellow
COLOR_PATH=135    # teal
COLOR_EXEC=10     # green

# Override the PS1 prompt with our custom colors
PS1='${debian_chroot:+($debian_chroot)}\[\033[38;5;${COLOR_HOST}m\]\u@\h\[\033[00m\]:\[\033[38;5;${COLOR_PATH}m\]\w\[\033[00m\]\$ '

# Set custom colors for ls output
LS_COLORS="$(echo $LS_COLORS | sed "s/di=01;34/di=38;5;$COLOR_PATH/" | sed "s/ex=01;34/ex=38;5;$COLOR_EXEC/")"
export LS_COLORS

## commands relative to root of current git repository

# navigate to root of repository
alias cdg='cd "$(git rev-parse --show-cdup)"'

# navigate to the root of an npm package
cdp() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/package.json" ]]; then
            cd "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    echo "No package.json found in current path"
    return 1
}

# list files at root of repository
alias lsg='ls "$(git rev-parse --show-cdup)"'

# enable vi mode in the terminal
# if you are not a vim user you may want to comment this out
set -o vi

# git tab completion (ships with git)
if ! complete -p git >/dev/null 2>&1 && [ -f /usr/share/bash-completion/completions/git ]; then
    . /usr/share/bash-completion/completions/git
fi

# github cli auth alias
alias gha='gh auth login --git-protocol https --web --clipboard'

# Additions from individual install steps (docker socket, virtual display, ...).
for _dd_f in "$HOME"/.docker-dev/bashrc.d/*.sh; do
    [ -r "$_dd_f" ] && . "$_dd_f"
done
unset _dd_f
