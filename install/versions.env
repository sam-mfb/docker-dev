# Pinned versions for every tool install.sh installs.
#
# Each value is either an exact version or "latest". With "latest", a tool that
# is already present is left alone; run install.sh with --force (and --only the
# step) to upgrade it. With an exact version, a different installed version
# counts as missing and is replaced.
#
# A variable set in the environment overrides its value here.
#
# Plain distro packages (vim, tmux, ripgrep, ...) are not listed; they come
# from the base image's apt sources at whatever version those carry.

# --- base ---
GIT_VERSION=latest              # Ubuntu: git-core PPA. Debian: distro git.

# --- languages ---
NVM_VERSION=0.40.5
NODE_VERSION=lts/jod            # any version spec nvm accepts
NPM_VERSION=11.17.0
RUST_VERSION=latest             # rustup toolchain; latest = stable
UV_VERSION=latest
DOTNET_CHANNEL=10.0
DOTNET_VERSION=latest           # latest SDK within DOTNET_CHANNEL
PWSH_VERSION=7.6.2
# rush 5.179.0 depends on @rushstack/node-core-library@5.24.1, which was never
# published to npm (the registry only has up to 5.24.0), so it fails to install.
RUSH_VERSION=5.178.0

# --- docker ---
DOCKER_CLI_VERSION=latest
DOCKER_COMPOSE_VERSION=5.1.4

# --- cloud ---
GH_VERSION=latest
AZ_VERSION=latest
AZ_DEVOPS_VERSION=latest

# --- desktop ---
# Browsers and the OS libraries they need. Pin an exact version to go back.
PLAYWRIGHT_VERSION=latest

# --- forwarders ---
GCF_VERSION=latest              # git-credential-forwarder
O2F_VERSION=latest              # oauth2-forwarder

# --- ai ---
CLAUDE_VERSION=latest           # latest | stable | exact version
CLAUDE_META_VERSION=latest      # claude-meta plugin; only latest is supported
CODEX_VERSION=latest
AGY_VERSION=latest              # Antigravity CLI; only latest is supported
OPENCODE_VERSION=latest
KKT_VERSION=latest
MUSE_VERSION=latest             # Muse Code; only latest is supported
